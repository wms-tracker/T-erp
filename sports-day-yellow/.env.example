# ---------------------------------------------------------------
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงจาก Supabase
# (Project Settings → API) — ห้าม commit ไฟล์ .env.local
# ถ้าไม่ใส่ค่า ระบบจะทำงานใน "โหมด Demo" (เก็บข้อมูลในเบราว์เซอร์เครื่องนี้เท่านั้น)
# ---------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# login = ต้องเข้าสู่ระบบด้วยอีเมล/รหัสผ่าน (แนะนำ)
# none  = ไม่ต้องล็อกอิน (ต้องรันส่วน "OPTIONAL: anon access" ใน supabase/schema.sql ด้วย)
VITE_AUTH_MODE=login
